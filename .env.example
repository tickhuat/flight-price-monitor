# Flight Price Monitor - Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!

# === Travelpayouts API (optional, for cached price data) ===
# Register at: https://www.travelpayouts.com/
# Go to: Programs > Aviasales > Tools > API
# Copy your API token
TRAVELPAYOUTS_TOKEN=

# === Email (Gmail recommended) ===
# For Gmail: enable 2-Step Verification, then create an App Password:
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your.email@gmail.com
